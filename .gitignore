# Local test server — Mojang's server jar and everything it unpacks.
# Never publish these: they are Mojang's code, not ours. The harness downloads
# what it needs; see README.
testserver/server.jar
testserver/libraries/
testserver/versions/
testserver/world/
testserver/logs/
testserver/crash-reports/
testserver/*.log
testserver/*.json
testserver/*.properties
testserver/*.txt
testserver/node_modules/
testserver/probe*.mjs

# Server/tool logs anywhere, not just under testserver/. A root-level server.log was committed in
# b79641b and survived review — the rules above only covered testserver/, and running the server from
# the repo root put the log somewhere nothing matched. Rotated logs are compressed, so mod/logs/
# put a *.log.gz in front of the same gap on 2026-08-01.
*.log
*.log.gz

# Scratch
.superpowers/
__pycache__/
*.pyc

# build artifacts — the pack is built from shadowslave/, never committed
dist-*.zip
shadowslave-*.zip
.idea/
